# ═══════════════════════════════════════════════════════════════════════════════
# MJ Studio RAG — Variables d'environnement (EXEMPLE — jamais de vraie clé ici)
# Copier vers backend/.env et frontend/.env.local
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Backend (backend/.env) ───────────────────────────────────────────────────
MOCK=true
PORT=3001
JWT_SECRET=changez_moi_en_production_minimum_32_caracteres
CORS_ORIGINS=http://localhost:5173,https://votre-app.vercel.app
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ─── OCR Tesseract (PDF scannés) ──────────────────────────────────────────────
# true  → OCR automatique sur les pages sans texte (défaut)
# false → désactiver l'OCR (gain de RAM en prod légère)
OCR_ENABLED=true
# Langues Tesseract (séparées par +) : fra, eng, ara, deu, etc.
OCR_LANGS=fra+eng

# ─── SMTP (réinitialisation mot de passe en production) ───────────────────────
# Utiliser un "Mot de passe d'application" Gmail (pas le mot de passe du compte).
# Générer sur : https://myaccount.google.com/apppasswords
# (Compte Google → Sécurité → Validation en 2 étapes → Mots de passe d'application)
#
# Gmail :
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
# Brevo (ex-Sendinblue, gratuit 300 mails/jour) :
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="MJ Studio RAG" <votre.adresse@gmail.com>

# ─── IA (optionnel en MOCK — fallback extraits locaux) ────────────────────────
COHERE_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ─── Supabase (optionnel — sinon fichiers JSON locaux) ────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Frontend (frontend/.env.local) ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001

# ─── AWS / Terraform (optionnel — infra/legacy) ───────────────────────────────
AWS_REGION=eu-west-1
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=kb-index
S3_BUCKET_DOCS=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
